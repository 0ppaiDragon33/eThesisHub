rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCoordinator() {
      return signedIn() && myRole() == 'coordinator';
    }

    function isDean() {
      return signedIn() && myRole() == 'dean';
    }

    function invitedRoleFor(email) {
      return get(/databases/$(database)/documents/facultyInvites/$(email)).data.role;
    }

    function hasInvite(email) {
      return exists(/databases/$(database)/documents/facultyInvites/$(email));
    }

    function inviteUnconsumed(email) {
      // Tolerate a missing `consumedAt` key rather than erroring (which
      // would deny). Console-created invites are currently the only way to
      // issue one, so an admin who omits `consumedAt: null` must not get a
      // silent, undiagnosable failure.
      return get(/databases/$(database)/documents/facultyInvites/$(email))
             .data.get('consumedAt', null) == null;
    }

    // Only the listed fields may differ between the stored and incoming doc.
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(fields);
    }

    match /users/{uid} {
      allow get: if signedIn() &&
                 (request.auth.uid == uid || isCoordinator() || isDean());
      allow list: if isCoordinator() || isDean();

      // Self-registration: student role only, only for yourself, and only
      // the fields createStudentProfile actually writes.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.email == myEmail()
                    && request.resource.data.keys().hasOnly(
                         ['fullName', 'email', 'role', 'college', 'program',
                          'specialization', 'active', 'createdAt', 'createdBy'])
                    && request.resource.data.active == true
                    && request.resource.data.createdBy == null
                    && request.resource.data.createdAt == request.time;

      // Profile edits by the owner, but never the role.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && onlyChanged(['fullName', 'college', 'program', 'specialization']);

      // Invite promotion: only to exactly the invited role, for your own
      // email, and only while the invite is still unconsumed (so it cannot
      // be replayed after the invitee has already marked it consumed).
      allow update: if verified()
                    && request.auth.uid == uid
                    && onlyChanged(['role'])
                    && hasInvite(myEmail())
                    && inviteUnconsumed(myEmail())
                    && request.resource.data.role == invitedRoleFor(myEmail());

      // Coordinators administer accounts but may never write `role`, and may
      // never target their own account. Role changes happen only by the
      // invitee applying an invite the coordinator issued, and coordinators
      // can never invite themselves (see facultyInvites `create`/`update`
      // below). The beneficiary of an elevation can never remove its
      // facultyInvites record (only mark it consumed) — but coordinators can
      // delete or overwrite invites, so this is not a permanent guarantee.
      allow update: if isCoordinator()
                    && request.auth.uid != uid
                    && onlyChanged(['fullName', 'college', 'program',
                                    'specialization', 'active']);

      allow delete: if false;
    }

    match /facultyInvites/{email} {
      // You may read only your own invite once your address is verified, or
      // if you're a coordinator; the collection is never listable by anyone
      // but a coordinator.
      allow get: if (verified() && myEmail() == email) || isCoordinator();
      allow list: if isCoordinator();

      // Coordinators issue invites, but never to themselves, and only for a
      // real role — this is what closes off the self-invite escalation path.
      //
      // `college` and `specialization` ride along on the invite and are
      // applied to the account at promotion, because nothing else in the app
      // fills them. They are optional: an invite may omit either.
      //
      // The key whitelist is what stops a coordinator planting anything else
      // here. Without it this create was unbounded, the same gap the thesis
      // create rule had — and an invite document is read during promotion,
      // so junk planted here reaches a privilege decision.
      allow create, update: if isCoordinator()
                            && email != myEmail()
                            && request.resource.data.keys().hasOnly(
                                 ['role', 'invitedBy', 'createdAt',
                                  'consumedAt', 'college', 'specialization'])
                            && request.resource.data.role in
                               ['faculty', 'coordinator', 'dean']
                            && request.resource.data.invitedBy ==
                               request.auth.uid
                            // `.get(key, default)` so a caller that omits an
                            // optional field is accepted while one that
                            // supplies it is held to the pinned value —
                            // absence and the correct value are equivalent,
                            // a wrong value is not. A backdated `createdAt`
                            // or an invite that arrives pre-consumed are both
                            // refused.
                            && request.resource.data.get('createdAt',
                                 request.time) == request.time
                            && request.resource.data.get('consumedAt', null)
                               == null;

      // The invitee marks their own invite consumed; they may never delete
      // it, so a completed promotion always leaves a record.
      allow update: if verified()
                    && myEmail() == email
                    && onlyChanged(['consumedAt'])
                    && request.resource.data.consumedAt == request.time;

      // Only coordinators may delete invites (e.g. to retract an unclaimed
      // one). The invitee can never delete their own — see the consume-only
      // branch above.
      allow delete: if isCoordinator();
    }

    match /auditLogs/{logId} {
      allow create: if signedIn()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['actorUid', 'action', 'targetType', 'targetId',
                          'metadata', 'timestamp'])
                    && request.resource.data.timestamp == request.time;
      allow get, list: if isCoordinator() || isDean();
      allow update, delete: if false;
    }

    function thesisData(thesisId) {
      return get(/databases/$(database)/documents/theses/$(thesisId)).data;
    }

    function isThesisLeader(thesisId) {
      return signedIn() && thesisData(thesisId).leaderUid == request.auth.uid;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function hasNomination(thesisId, uid) {
      return exists(/databases/$(database)/documents/theses/$(thesisId)/nominations/$(uid));
    }

    function nominationData(thesisId, uid) {
      return get(/databases/$(database)/documents/theses/$(thesisId)/nominations/$(uid)).data;
    }

    // Single-value cross-check for the Dean's approval, the same technique
    // already used for `adviserUid`: the approved candidate must be a real
    // document on THIS thesis. Declared here rather than inline so the path
    // stays on one line and parses.
    function candidateTitleExists(thesisId, titleId) {
      return exists(/databases/$(database)/documents/theses/$(thesisId)/candidateTitles/$(titleId));
    }

    match /theses/{thesisId} {
      // Finding (h): a nominee who has been asked for their Conforme needs
      // the thesis title in their inbox, and `respondToNomination` reads the
      // thesis inside its transaction — neither worked before, because a
      // pending nominee is not yet on `panelistUids` (that array is only
      // filled at dean approval). The thesis document is bound once with
      // `let` so the leader/adviser/panel checks share a single read.
      function mayReadThesis() {
        let t = thesisData(thesisId);
        return signedIn() && (
          t.leaderUid == request.auth.uid ||
          t.adviserUid == request.auth.uid ||
          request.auth.uid in t.panelistUids ||
          hasNomination(thesisId, request.auth.uid)
        );
      }

      allow get: if mayReadThesis() || isCoordinator() || isDean();

      // Finding (b): `watchThesisForLeader` queries
      // `where('leaderUid', == , uid)`, which is a `list`, not a `get` — the
      // student dashboard was denied outright. The leader arm is evaluated
      // per returned document and is checked first so a student never pays
      // for the `users` read that isCoordinator()/isDean() cost.
      // Finding (b) gave the leader arm. M2 adds the adviser arm: an
      // adviser must be able to find the theses whose chapters they review.
      // Narrow by construction -- the arm is evaluated per returned
      // document, so it can only ever return theses naming this adviser.
      allow list: if (signedIn() && resource.data.leaderUid == request.auth.uid)
                  || (signedIn() && resource.data.adviserUid == request.auth.uid)
                  || isCoordinator() || isDean();

      // A leader creates their own thesis, always as a draft with an empty
      // panel. Nothing here may arrive pre-approved.
      //
      // Finding (d): without `hasOnly` a leader could smuggle in
      // `deanApprovedBy`, a client-chosen `createdAt`, or arbitrary junk at
      // creation time — the update branches below only police the fields
      // they name, so anything planted at create survived untouched. Every
      // approval-track field is therefore pinned to its empty value here.
      //
      // The pins use `.get(key, default)` rather than a bare field read so a
      // caller that simply omits an optional field (as the pre-existing
      // "student may create their own thesis as draft" test does) is still
      // accepted, while a caller that *supplies* one is held to the pinned
      // value. Absence and the correct value are equivalent; a wrong value
      // is not.
      allow create: if verified()
                    && request.resource.data.keys().hasOnly(
                         ['leaderUid', 'workingTitle', 'memberNames',
                          'college', 'program', 'semester', 'academicYear',
                          'status', 'adviserUid', 'panelistUids',
                          'coordinatorRecommendedAt', 'coordinatorRecommendedBy',
                          'deanApprovedAt', 'deanApprovedBy', 'createdAt'])
                    && request.resource.data.leaderUid == request.auth.uid
                    && request.resource.data.status == 'draft'
                    && request.resource.data.adviserUid == null
                    && request.resource.data.panelistUids.size() == 0
                    && request.resource.data.academicYear.matches('[0-9]{4}-[0-9]{4}')
                    && request.resource.data.get('createdAt', request.time) == request.time
                    && request.resource.data.get('coordinatorRecommendedAt', null) == null
                    && request.resource.data.get('coordinatorRecommendedBy', null) == null
                    && request.resource.data.get('deanApprovedAt', null) == null
                    && request.resource.data.get('deanApprovedBy', null) == null;

      // The leader edits group details and may submit the nomination, but
      // may never touch the approval fields. Beyond the plan's original
      // membership check (`status in ['draft', 'nominationPendingConforme']`),
      // this also pins the status transition itself: without a prior-status
      // guard a leader could revert an already-approved thesis back to
      // 'draft' (or replay the submit step) at any point after coordinator
      // or dean action, undoing their sign-off with no matching event. The
      // only status changes allowed here are "no change" (editing group
      // details) and the single forward step draft -> nominationPendingConforme.
      //
      // Finding (e): the branch also had no *current*-status floor, so a
      // leader could still rewrite `workingTitle` and `memberNames` on a
      // thesis the dean had already approved — the approved record could
      // drift away from what was signed. The thesis is now frozen to the
      // leader the moment it leaves `draft`; the only write left to them is
      // the single submit step below.
      // `nominationsSubmittedAt` is the letter date Form 1 prints and is set
      // by the same write that flips status to 'nominationPendingConforme'
      // (`ThesisRepository.submitNominations`'s batch). It is optional here
      // (`.get(..., request.time)` defaults to a trivially-true comparison
      // when the key is absent, which covers the plain in-place edits this
      // branch also serves) but when supplied it is pinned to `request.time`
      // exactly like the coordinator/dean timestamps below, so a leader can
      // never backdate the letter their own submission produces.
      allow update: if isThesisLeader(thesisId)
                    && resource.data.status == 'draft'
                    && onlyChanged(['memberNames', 'workingTitle', 'college',
                                    'program', 'semester', 'academicYear',
                                    'status', 'nominationsSubmittedAt'])
                    && (
                      request.resource.data.status == 'draft'
                      || request.resource.data.status ==
                         'nominationPendingConforme'
                    )
                    && request.resource.data.get('nominationsSubmittedAt',
                         request.time) == request.time;

      // A nominee's acceptance advances the status — but ONLY the caller's
      // own nomination on THIS thesis, and only forward from the exact
      // stage that acceptance belongs to. Ruling 2: the plan's original form
      // (`verified() && onlyChanged(['status']) && ... == 'nominationPendingCoordinator'`)
      // let any verified stranger flip any thesis into that state. This adds
      // (a) proof the caller is a nominee on this thesis via a
      // nominations/{uid} doc, and (b) a prior-status pin so the transition
      // can never be replayed to walk a thesis backwards from a later stage.
      //
      // Finding (a): mere existence of a nomination was too weak. Two people
      // who must never advance a thesis both hold one — a nominee who has
      // *declined* (`conformeStatus: 'declined'`), and the Dean or any
      // Research Coordinator, who sit ex officio on EVERY thesis
      // (`conformeStatus: 'exOfficio'`) and were never asked. Both were
      // proven able to advance. The caller's own seat must now be one that
      // was genuinely asked for a Conforme and has not refused.
      //
      // LIMITATION — this pins the seat, not the answer. The intended check
      // is `== 'accepted'`, and it cannot be expressed while the client
      // advances atomically. `respondToNomination` writes the acceptance and
      // the status flip in ONE transaction, and rules evaluate every write
      // in a transaction against the state BEFORE it: the caller's own
      // nomination still reads `pending` at evaluation time, so `==
      // 'accepted'` denies the legitimate flow outright. Verified against
      // the emulator (probe: transaction accept+advance under an
      // `== 'accepted'` rule -> permission-denied; the same two writes issued
      // sequentially -> allowed). Tightening this to `== 'accepted'` requires
      // first splitting `respondToNomination` into two sequential commits,
      // which trades this for a thesis that wedges if the second commit is
      // lost. `'pending'` is therefore accepted here and the residual gap is
      // narrow: the caller must still hold a real, asked, unrefused seat on
      // THIS thesis. Rules cannot check the OTHER nominees' answers under any
      // formulation (no array/collection iteration) — that quorum check lives
      // in `respondToNomination`'s transaction and is not expressible here.
      allow update: if verified()
                    && hasNomination(thesisId, request.auth.uid)
                    && nominationData(thesisId, request.auth.uid)
                       .conformeStatus in ['pending', 'accepted']
                    && resource.data.status == 'nominationPendingConforme'
                    && onlyChanged(['status'])
                    && request.resource.data.status ==
                       'nominationPendingCoordinator';

      // Same prior-status pin: without it, a coordinator could push ANY
      // thesis (a draft, one still awaiting Conforme, even an already
      // approved one) straight to 'nominationPendingDean', skipping the
      // nomination stage entirely or reopening an approved thesis.
      //
      // Finding (f): `coordinatorRecommendedAt` was unpinned and a probe
      // backdated it to 1999. The client writes
      // `FieldValue.serverTimestamp()`, which arrives as exactly
      // `request.time`, so pinning it costs nothing and makes the audit
      // trail's dates unforgeable.
      allow update: if isCoordinator()
                    && onlyChanged(['status', 'coordinatorRecommendedAt',
                                    'coordinatorRecommendedBy'])
                    && request.resource.data.coordinatorRecommendedBy ==
                       request.auth.uid
                    && request.resource.data.coordinatorRecommendedAt ==
                       request.time
                    && resource.data.status == 'nominationPendingCoordinator'
                    && request.resource.data.status == 'nominationPendingDean';

      // Same prior-status pin: without it, a dean could approve directly
      // from any stage, skipping coordinator recommendation entirely.
      //
      // The derived panel is now checked as far as rules can reach:
      //
      // - `adviserUid` is a single value, so the nomination it names can be
      //   fetched directly and must actually read `accepted`. A probe
      //   previously installed `adviserUid: 'never-accepted-uid'` unopposed.
      // - `panelistUids[]` genuinely cannot be validated: rules have no way
      //   to iterate an array against sibling documents, so only its size is
      //   checkable here. That every listed panelist accepted is enforced in
      //   `ThesisRepository.approve`'s transaction, which re-reads each
      //   nomination before writing. This remains a documented limitation.
      //
      // Finding (f): `deanApprovedAt` is pinned to `request.time` for the
      // same reason as the coordinator's timestamp above.
      allow update: if isDean()
                    && onlyChanged(['status', 'deanApprovedAt',
                                    'deanApprovedBy', 'adviserUid',
                                    'panelistUids'])
                    && request.resource.data.deanApprovedBy == request.auth.uid
                    && request.resource.data.deanApprovedAt == request.time
                    && resource.data.status == 'nominationPendingDean'
                    && request.resource.data.status == 'nominationApproved'
                    && request.resource.data.panelistUids.size() >= 3
                    && request.resource.data.adviserUid != null
                    && hasNomination(thesisId, request.resource.data.adviserUid)
                    && nominationData(thesisId, request.resource.data.adviserUid)
                       .conformeStatus == 'accepted';

      // ---------------------------------------------------------------
      // M1b — the title defence.
      // ---------------------------------------------------------------

      // The leader submits the candidate titles: this is the write that moves
      // the thesis into the defence. `titleRejected` is a legal starting point
      // too, so a rejected set can be resubmitted as a new round.
      //
      // The prior-status pin is what stops this being replayed: once the
      // thesis is at `titlePendingDefence` the leader cannot re-run it, so
      // they cannot swap the presentation (or bump the round, orphaning the
      // candidates the panel is looking at) while the defence is under way.
      // `titlesSubmittedAt` is pinned to `request.time` for the same reason
      // every other timestamp in this file is: the client writes
      // `FieldValue.serverTimestamp()`, so pinning costs nothing and makes
      // the date unforgeable.
      //
      // `titleRound` is NOT constrained. It is written by the same batch that
      // creates the candidates, and rules cannot count the candidates that
      // batch creates; it is a history field the client derives, not a
      // privilege one. See the limitation note in the report.
      allow update: if verified()
                    && isThesisLeader(thesisId)
                    && resource.data.status in
                       ['nominationApproved', 'titleRejected']
                    && request.resource.data.status == 'titlePendingDefence'
                    && onlyChanged(['status', 'titleRound',
                                    'titlesSubmittedAt', 'presentationPath',
                                    'presentationUrl',
                                    'titleDecidedAt', 'titleDecidedBy',
                                    'titleRejectionRemark'])
                    && request.resource.data.titlesSubmittedAt == request.time
                    // The previous round's decision must be CLEARED by the
                    // same write that opens the new one. Without this the
                    // three fields survived the resubmission, `titleDecided()`
                    // stayed true forever, and from round 2 onward the leader
                    // read the panel's remarks live, mid-defence — the one
                    // guarantee this milestone exists to keep. Pinned to null
                    // rather than merely permitted: widening `onlyChanged`
                    // alone would let a leader FORGE a decision (set
                    // `titleDecidedAt` themselves) and unlock the comments on
                    // their own defence. `.get(k, null)` covers both the
                    // `FieldValue.delete()` the client sends and a first
                    // submission where the keys never existed.
                    && request.resource.data.get('titleDecidedAt', null) == null
                    && request.resource.data.get('titleDecidedBy', null) == null
                    && request.resource.data
                         .get('titleRejectionRemark', null) == null;

      // The Dean records the decision. Pinned to the prior status so it can
      // neither be replayed (a decided thesis has left `titlePendingDefence`,
      // so a second decision is refused) nor skipped (a thesis that never had
      // a defence cannot be jumped straight to `titleApproved`).
      //
      // The two arms are exclusive on the outgoing status, and each names its
      // own field set, so an approval cannot smuggle in a rejection remark
      // and a rejection cannot smuggle in an `approvedTitleId`.
      allow update: if verified()
                    && isDean()
                    && resource.data.status == 'titlePendingDefence'
                    && (
                      (request.resource.data.status == 'titleApproved'
                       && onlyChanged(['status', 'approvedTitleId',
                                       'titleDecidedAt', 'titleDecidedBy'])
                       // The rules cannot iterate the candidate collection, so
                       // the approved candidate is checked for existence on
                       // this thesis but its `round` is not verified — see the
                       // limitation in the report.
                       && candidateTitleExists(thesisId,
                            request.resource.data.approvedTitleId))
                      ||
                      (request.resource.data.status == 'titleRejected'
                       && onlyChanged(['status', 'titleRejectionRemark',
                                       'titleDecidedAt', 'titleDecidedBy'])
                       && request.resource.data.titleRejectionRemark is string
                       && request.resource.data.titleRejectionRemark.size() > 0)
                    )
                    && request.resource.data.titleDecidedBy == request.auth.uid
                    && request.resource.data.titleDecidedAt == request.time;

      allow delete: if false;

      match /nominations/{nomineeUid} {
        // The leader writes every entry, including the ex officio ones. Three
        // separate holes were proven here and all three are closed by this
        // one predicate; the thesis document and the nominee's role are each
        // bound once with `let`, so the whole check costs two reads.
        //
        // Critical 1 — `exOfficio` was student-controlled. The old rule
        // pinned `true` + `'exOfficio'` as a legal PAIR but never asked
        // whether the nominee holds an office, so a leader could write any
        // faculty member as `exOfficio: true` and that adviser or panelist
        // would never be asked and never block. `exOfficio: true` now
        // requires the nominee's real role to be `dean` or `coordinator`.
        // The implication is deliberately one-directional: an office holder
        // nominated AS ADVISER carries `exOfficio: false` and must accept
        // like anyone else, and that case is unaffected.
        //
        // The role is read from `users/{nomineeUid}` rather than from
        // `facultyDirectory/{nomineeUid}`: the directory is a client-written
        // mirror maintained by its own subject at sign-in (see below), so
        // trusting it here would make ex-officio status self-declarable —
        // exactly the amplification finding (g) describes. `users.role` is
        // the single source of truth, is writable only via the invite flow,
        // and exists for every account, whereas a directory entry only
        // appears after that faculty member's first sign-in.
        //
        // Critical 2 — nothing required the nominee to be anyone other than
        // the leader themselves. A student nominated their OWN uid as
        // ex officio, flipped the thesis to nominationPendingConforme, then
        // satisfied the advance rule with their own nomination doc and
        // reached the coordinator's desk with zero faculty participation.
        // A nominee must now be a real, non-student account and must not be
        // the leader.
        //
        // The `nomineeUid` field is pinned to the document id because the
        // faculty inbox's collection-group query filters on the field while
        // the collection-group read rule authorises on the id; if they could
        // disagree, one nominee's seat could be filed under another's query.
        function mayCreateNomination() {
          let t = thesisData(thesisId);
          let role = roleOf(nomineeUid);
          let d = request.resource.data;
          return signedIn()
                 && t.leaderUid == request.auth.uid
                 // Critical 3 — see the `delete` rule below.
                 && t.status == 'draft'
                 && nomineeUid != request.auth.uid
                 && role in ['faculty', 'coordinator', 'dean']
                 && d.nomineeUid == nomineeUid
                 && (
                      (d.exOfficio == false && d.conformeStatus == 'pending')
                      ||
                      (d.exOfficio == true
                       && d.conformeStatus == 'exOfficio'
                       && role in ['coordinator', 'dean'])
                    );
        }

        // C1 — the Conforme stage was denied for every real faculty user.
        //
        // A nominee must be able to read their CO-nominees, not only their own
        // seat. `ThesisRepository.respondToNomination` cannot decide whether
        // the acceptance it is about to write is the LAST outstanding one
        // without seeing every sibling nomination on this thesis, and that
        // quorum check is not expressible in rules (no collection iteration —
        // see the LIMITATION note on the advance rule above). So the client
        // lists `theses/{id}/nominations` and then `tx.get`s each document.
        //
        // Under the previous form both were denied: the `list` never binds the
        // {nomineeUid} wildcard (it evaluates to null across the queried
        // collection), so `request.auth.uid == nomineeUid` was false, and a
        // nominee reading a co-nominee's document failed the same comparison.
        // The list is the first call `respondToNomination` makes, so it threw
        // before the transaction even opened: every faculty member tapped
        // Accept, saw "Could not record your response.", and no thesis could
        // ever leave `nominationPendingConforme`.
        //
        // SCOPE — this cannot be used to enumerate other theses.
        // `hasNomination()` is evaluated against `thesisId`, the wildcard of
        // the ENCLOSING `match /theses/{thesisId}`, which is bound for every
        // `get`/`list` addressed at `theses/{thesisId}/nominations`. The
        // caller therefore reaches exactly the nominations of a thesis they
        // themselves hold a seat on, and holding that seat is not something
        // they can grant themselves — only the leader creates nominations, and
        // only while the thesis is still `draft` (`mayCreateNomination()`).
        // Cross-thesis reads are a different match block entirely
        // (`/{path=**}/nominations/{nomineeUid}` at the bottom of this file),
        // which is untouched and still admits only
        // `resource.data.nomineeUid == request.auth.uid` — so the faculty
        // inbox's collection-group query is still one nominee's own seats, and
        // an unfiltered scan of every nomination is still denied.
        //
        // NOT gated on the caller's own seat being non-`declined`, deliberately:
        // - It would protect nothing. The roster is fixed the moment the
        //   thesis leaves `draft` (create and delete are both pinned to
        //   `draft`), so a nominee who declines has already lawfully read
        //   every co-nominee this arm would later show them. Denying the
        //   second read of an unchanged list withholds no information.
        // - It would re-create C1 in miniature. The nomination `update` rule
        //   below accepts `conformeStatus in ['accepted', 'declined']` with no
        //   pin on the prior value, so a nominee who declined and then wants to
        //   accept after all is permitted to WRITE that reversal — and the only
        //   client path to it, `respondToNomination`, opens with exactly this
        //   list. Denying the read while permitting the write is the precise
        //   shape of the defect this arm exists to close.
        //   (Residual, pre-existing and unchanged here: such a reversal can
        //   record the acceptance but cannot itself trip the advance, because
        //   the thesis `update` rule pins the caller's seat to
        //   ['pending', 'accepted'] and theirs still reads 'declined'.)
        // - Domain: everyone on a panel is printed together on Form 1, which
        //   is handed to the Dean, so co-panel visibility is not a disclosure.
        //
        // This is a READ widening only. No write rule is touched.
        function isNomineeOnThisThesis() {
          return signedIn() && hasNomination(thesisId, request.auth.uid);
        }

        allow get, list: if request.auth.uid == nomineeUid
                         || isNomineeOnThisThesis()
                         || isThesisLeader(thesisId)
                         || isCoordinator() || isDean();

        allow create: if mayCreateNomination();

        // Only the nominee answers, and only on a seat that was asked.
        //
        // Finding (f): `respondedAt` was unpinned and a probe backdated it.
        // It must now be either left exactly as it stands or set to
        // `request.time` — which is what the client's
        // `FieldValue.serverTimestamp()` produces. The "unchanged" arm keeps
        // a caller that writes only `conformeStatus` working; it cannot be
        // used to plant a date, because the stored value it must match could
        // only have come from an earlier pinned write.
        allow update: if verified()
                      && request.auth.uid == nomineeUid
                      && resource.data.exOfficio == false
                      && onlyChanged(['conformeStatus', 'respondedAt',
                                      'declineReason'])
                      && request.resource.data.conformeStatus in
                         ['accepted', 'declined']
                      && (request.resource.data.respondedAt == request.time
                          || request.resource.data.respondedAt ==
                             resource.data.respondedAt);

        // Critical 3 — decline laundering. The leader correctly could not
        // UPDATE a declined nomination, but could delete it and re-create
        // the same uid as `exOfficio: true`, erasing the refusal; the same
        // move reset any `pending` seat that was taking too long to answer.
        // Both `create` (above) and `delete` are therefore confined to a
        // thesis that is still `draft` — once nominations have gone out, the
        // roster is fixed and only the nominees themselves can write to it.
        //
        // INTENTIONAL: this makes the `declined` arm below unreachable in
        // practice, because declines only happen at
        // nominationPendingConforme. That is deliberate. A re-nomination
        // flow is planned and will need this reopened — but it must be
        // reopened with its own guard (an audit record, a status the leader
        // cannot reach unilaterally, or coordinator approval), NOT by simply
        // dropping the `draft` pin, which is what made laundering possible.
        allow delete: if isThesisLeader(thesisId)
                      && thesisData(thesisId).status == 'draft'
                      && resource.data.conformeStatus == 'declined';
      }

      // A panel member on this thesis: the adviser, anyone on panelistUids,
      // or anyone holding an accepted/ex-officio nomination — which covers
      // the ex officio Coordinator and Dean, who never appear in
      // panelistUids and whose `conformeStatus` is permanently `exOfficio`
      // because they are never asked to accept.
      //
      // Gated on `conformeStatus`: a nomination document can outlive a
      // decline (it cannot be deleted once the thesis leaves `draft`), so
      // checking mere existence via `hasNomination()` let a nominee who
      // explicitly declined keep panel access — reading titleComments,
      // reading titleComposing, and posting comments into the official
      // record. `nominationData()` is reused here (rather than a second
      // `get()`) because each `get()` counts against the per-evaluation
      // limit.
      function isOnPanel() {
        let t = thesisData(thesisId);
        return signedIn() && (
          t.adviserUid == request.auth.uid ||
          request.auth.uid in t.panelistUids ||
          (hasNomination(thesisId, request.auth.uid) &&
           nominationData(thesisId, request.auth.uid).conformeStatus
             in ['accepted', 'exOfficio'])
        );
      }

      // `.get(key, default)` rather than a bare read: a thesis that has never
      // reached a decision has no `titleDecidedAt` key at all, and a bare
      // read of a missing key errors, which denies — including for the panel
      // arms that never needed this check.
      function titleDecided() {
        return thesisData(thesisId).get('titleDecidedAt', null) != null;
      }

      match /candidateTitles/{titleId} {
        allow get, list: if isThesisLeader(thesisId) || isOnPanel()
                         || isCoordinator() || isDean();

        // Only while the thesis is at a status that permits a submission.
        // Batched writes are evaluated against the state BEFORE the batch, so
        // the thesis is still `nominationApproved` (or `titleRejected`) here
        // even though the same batch moves it to `titlePendingDefence`.
        // Probed against the emulator rather than assumed — see the two-sided
        // "batch evaluation order" test in rules.test.js, which shows the
        // batched form allowed and the same two writes issued SEQUENTIALLY
        // denied, because by then the status has already moved.
        //
        // `round` is deliberately NOT validated: for the same reason, it
        // would be compared against the previous round. It is a history
        // field, not a security one.
        allow create: if verified()
                      && isThesisLeader(thesisId)
                      && thesisData(thesisId).status in
                         ['nominationApproved', 'titleRejected']
                      && request.resource.data.keys().hasOnly(
                           ['titleText', 'justificationPath',
                            'justificationUrl', 'round', 'position',
                            'submittedAt'])
                      && request.resource.data.position is int
                      && request.resource.data.position >= 0
                      && request.resource.data.titleText is string
                      && request.resource.data.titleText.size() > 0
                      && request.resource.data.submittedAt == request.time;

        // Immutable once submitted: the panel must never be reading a title
        // the student is still editing, and the Dean's `approvedTitleId`
        // points at a document whose text must not change under it.
        allow update, delete: if false;
      }

      match /titleComments/{commentId} {
        // The panel reads at any time. The leader reads only once the Dean
        // has recorded a decision — during the defence the students are in
        // the room presenting, and the remarks are not theirs to watch.
        allow get, list: if isOnPanel() || isCoordinator() || isDean()
                         || (isThesisLeader(thesisId) && titleDecided());

        // Only a panel member may remark, and only in their own name: without
        // the `authorUid` pin a panelist could file a comment under the
        // Dean's uid, and the student reads the author on every remark after
        // the decision.
        allow create: if verified()
                      && isOnPanel()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(
                           ['candidateTitleId', 'authorUid', 'authorName',
                            'authorRole', 'body', 'createdAt'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.createdAt == request.time;

        // Append-only, per parent design §6.4. A remark that could be edited
        // afterwards is not a record of what was said.
        allow update, delete: if false;
      }

      match /titleComposing/{uid} {
        // Faculty only. The leader must NEVER see who is typing — not before
        // the decision and not after it. The comments themselves are hidden
        // from them until the decision, and an indicator would leak both that
        // remarks exist and who is writing them.
        allow get, list: if isOnPanel() || isCoordinator() || isDean();

        // Your own marker only, so nobody can plant an indicator for someone
        // else or clear one they do not own. The document id IS the uid, which
        // is what makes that check possible.
        allow create, update: if verified()
                              && isOnPanel()
                              && uid == request.auth.uid
                              && request.resource.data.keys().hasOnly(
                                   ['name', 'role', 'candidateTitleId',
                                    'updatedAt'])
                              && request.resource.data.updatedAt
                                 == request.time;

        // The one collection in this system where delete is permitted, and
        // only of your own. Composing is transient by design: `clearComposing`
        // runs on blur and on submit, and a double clear must not throw.
        allow delete: if isOnPanel() && uid == request.auth.uid;
      }

      function isAdviser(thesisId) {
        return signedIn() && thesisData(thesisId).adviserUid == request.auth.uid;
      }

      function chapterIds() {
        return ['chapterI', 'chapterII', 'chapterIII', 'chapterIV',
                'chapterV'];
      }

      match /documents/{chapterId} {
        // The dean reads STATUS here and nothing below it: §3.1 gives them
        // college-wide progress visibility, not chapter review. The split
        // falls on the collection boundary, so no field filtering is needed.
        allow get, list: if isThesisLeader(thesisId) || isAdviser(thesisId)
                         || isCoordinator() || isDean();

        allow create: if verified()
                      && isThesisLeader(thesisId)
                      && thesisData(thesisId).status == 'titleApproved'
                      && chapterId in chapterIds()
                      && request.resource.data.keys().hasOnly(
                           ['type', 'currentVersion', 'status', 'updatedAt'])
                      && request.resource.data.type == chapterId
                      && request.resource.data.currentVersion == 1
                      && request.resource.data.status == 'submitted'
                      && request.resource.data.updatedAt == request.time;

        // Two disjoint arms, OR'd. The student reaches `submitted` only by
        // adding a version; the adviser writes only a decision. Neither can
        // perform the other's half, which is what makes the status
        // trustworthy without a server.

        // Student: a new version. Blocked once approved -- only the adviser
        // reopens, so a group cannot swap an approved chapter unseen.
        allow update: if verified()
                      && isThesisLeader(thesisId)
                      && resource.data.status in ['submitted', 'revise']
                      && request.resource.data.keys().hasOnly(
                           ['type', 'currentVersion', 'status', 'updatedAt'])
                      && request.resource.data.currentVersion
                         == resource.data.currentVersion + 1
                      && request.resource.data.status == 'submitted'
                      && request.resource.data.type == resource.data.type
                      && request.resource.data.updatedAt == request.time;

        // Adviser: a decision, never a version bump.
        allow update: if verified()
                      && isAdviser(thesisId)
                      && request.resource.data.keys().hasOnly(
                           ['type', 'currentVersion', 'status', 'updatedAt'])
                      && request.resource.data.status in ['revise', 'approved']
                      && request.resource.data.currentVersion
                         == resource.data.currentVersion
                      && request.resource.data.type == resource.data.type
                      && request.resource.data.updatedAt == request.time;

        allow delete: if false;

        match /versions/{versionNo} {
          // No dean: they see that a chapter is approved, never its files.
          allow get, list: if isThesisLeader(thesisId) || isAdviser(thesisId)
                           || isCoordinator();

          // Written in the SAME batch as the parent's version bump, and a
          // batch is evaluated against the state BEFORE it -- so the parent
          // still reads its old currentVersion here. The rule is therefore
          // written as "+ 1", never "==". Probed in rules.test.js with a
          // two-sided test, not assumed.
          //
          // On a group's FIRST upload the chapter document does not exist
          // yet at the time this rule evaluates (it is created in the SAME
          // batch) -- get() on a nonexistent document returns a snapshot
          // whose .data() is null, and `.data.currentVersion` on that
          // throws, denying the write outright. The existence branch below
          // is required, not optional: without it every group's first
          // upload is denied. Falsified in rules.test.js.
          allow create: if verified()
                        && isThesisLeader(thesisId)
                        && request.resource.data.keys().hasOnly(
                             ['version', 'storagePath', 'fileUrl',
                              'uploadedBy', 'uploadedAt', 'mimeType',
                              'sizeBytes'])
                        && request.resource.data.uploadedBy == request.auth.uid
                        && request.resource.data.uploadedAt == request.time
                        && request.resource.data.version is int
                        && string(request.resource.data.version) == versionNo
                        && (
                             !exists(/databases/$(database)/documents/theses/$(thesisId)/documents/$(chapterId))
                               ? request.resource.data.version == 1
                               : request.resource.data.version == get(/databases/$(database)/documents/theses/$(thesisId)/documents/$(chapterId)).data.currentVersion + 1
                           );

          // Nothing is ever overwritten: the history is a record, not a
          // snapshot.
          allow update, delete: if false;
        }

        match /feedback/{feedbackId} {
          allow get, list: if isThesisLeader(thesisId) || isAdviser(thesisId)
                           || isCoordinator();

          allow create: if verified()
                        && isAdviser(thesisId)
                        && request.resource.data.keys().hasOnly(
                             ['version', 'reviewerUid', 'reviewerName',
                              'reviewerRole', 'body', 'createdAt'])
                        && request.resource.data.reviewerUid
                           == request.auth.uid
                        && request.resource.data.body is string
                        && request.resource.data.body.size() > 0
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.version is int
                        && request.resource.data.version >= 1
                        && request.resource.data.version
                           <= get(/databases/$(database)/documents/theses/$(thesisId)/documents/$(chapterId)).data.currentVersion;

          // Append-only, per parent design §6.4. The student may already
          // have acted on the original wording.
          allow update, delete: if false;
        }
      }
    }

    match /defenses/{defenseId} {
      // `defenses` is top level, so the thesis is reached through the id
      // stored on the defence rather than through the path. The helpers
      // inside `match /theses/{thesisId}` are not in scope here.
      //
      // `leaderUid` is a snapshot field on the defence document itself
      // (validated against the live thesis at `create`, below), not a
      // live cross-document read: `onThisDefence()` and the leader arm of
      // `allow list` would otherwise call `thesisOf()` once per document
      // evaluated, and Firestore caps the number of document accesses a
      // single rule evaluation may make -- a `list` over many defences
      // would blow that budget.
      function defence() {
        return resource.data;
      }
      function incoming() {
        return request.resource.data;
      }
      function thesisOf(thesisId) {
        return get(/databases/$(database)/documents/theses/$(thesisId)).data;
      }

      function onThisDefence() {
        let d = defence();
        return signedIn() && (
          d.adviserUid == request.auth.uid ||
          request.auth.uid in d.panelUids ||
          d.leaderUid == request.auth.uid
        );
      }

      allow get: if onThisDefence() || isCoordinator() || isDean();

      // One arm per role, each evaluated per returned document, so none can
      // return a defence the caller does not belong to. The coordinator and
      // dean monitor college-wide, so their arm is unfiltered by design.
      allow list: if (signedIn()
                      && resource.data.adviserUid == request.auth.uid)
                  || (signedIn()
                      && request.auth.uid in resource.data.panelUids)
                  || (signedIn()
                      && resource.data.leaderUid == request.auth.uid)
                  || isCoordinator() || isDean();

      allow create: if verified()
                    && isCoordinator()
                    && incoming().keys().hasOnly(
                         ['thesisId', 'type', 'scheduledAt', 'venue',
                          'panelUids', 'adviserUid', 'leaderUid', 'status',
                          'createdBy', 'createdAt'])
                    && incoming().type in ['preOral', 'final']
                    && incoming().status == 'scheduled'
                    && incoming().createdBy == request.auth.uid
                    && incoming().createdAt == request.time
                    // Snapshots, not claims: a forged panel would grant
                    // comment rights to someone the group never nominated.
                    && incoming().panelUids
                       == thesisOf(incoming().thesisId).panelistUids
                    && incoming().adviserUid
                       == thesisOf(incoming().thesisId).adviserUid
                    && incoming().leaderUid
                       == thesisOf(incoming().thesisId).leaderUid;

      // Coordinator arm: the lifecycle, forward only, one step at a time.
      // Backwards would let a closed defence reopen for comments after the
      // record was consolidated.
      allow update: if verified()
                    && isCoordinator()
                    && incoming().diff(defence()).affectedKeys()
                       .hasOnly(['status'])
                    && (
                      (defence().status == 'scheduled'
                       && incoming().status == 'inProgress') ||
                      (defence().status == 'inProgress'
                       && incoming().status == 'completed')
                    );

      // Adviser arm: the release, once, and only after it is closed.
      // Guidelines §4d makes consolidation the adviser's act.
      allow update: if verified()
                    && defence().adviserUid == request.auth.uid
                    && defence().status == 'completed'
                    && !('consolidatedAt' in defence())
                    && incoming().diff(defence()).affectedKeys()
                       .hasOnly(['consolidatedAt'])
                    && incoming().consolidatedAt == request.time;

      // The defence record is evidence.
      allow delete: if false;
    }

    // The faculty inbox queries nominations across all theses.
    //
    // This authorises on the `nomineeUid` FIELD, not on the {nomineeUid}
    // document-id wildcard, and it has to: in a collection-group LIST the
    // path wildcards are not bound — they evaluate to null, because the
    // query spans every parent path and no single binding exists. The
    // previous form (`request.auth.uid == nomineeUid`) therefore compared
    // against null and denied the faculty inbox outright, on top of the
    // client-side `invalid-argument` that finding (c) describes. Proven
    // against the emulator: the doc-id form fails a collection-group query
    // with "Null value error"; the field form allows exactly the caller's
    // own nomination and still denies an unfiltered scan or a query for
    // someone else's uid, because Firestore checks a list rule against the
    // query's own constraints.
    //
    // The field is safe to trust here: the `create` rule pins it to the
    // document id, which is what every other rule in this file authorises
    // on, and no update branch can change it.
    match /{path=**}/nominations/{nomineeUid} {
      allow read: if verified()
                  && resource.data.nomineeUid == request.auth.uid;
    }

    match /facultyDirectory/{uid} {
      // Finding (g): the entry is written by its own subject (no Cloud
      // Functions on Spark), and the old rule checked only that the caller
      // was not a student — the document's CONTENT was unconstrained, so a
      // faculty member could self-declare `role: 'dean'`. That fed the
      // ex-officio picker and, before Critical 1 was fixed, the ex-officio
      // nomination path itself. The written role must now equal the caller's
      // real role from `users/{uid}`, and only the four keys
      // `upsertOwnEntry` actually writes are accepted.
      function mayWriteOwnDirectoryEntry() {
        let role = myRole();
        return signedIn()
               && request.auth.uid == uid
               && role != 'student'
               && request.resource.data.keys().hasOnly(
                    ['fullName', 'role', 'college', 'specialization'])
               && request.resource.data.role == role;
      }

      allow read: if verified();
      allow create, update: if mayWriteOwnDirectoryEntry();
      // Nobody removes a directory entry: a deleted entry would silently
      // drop an office holder out of the ex-officio picker. Deactivation
      // lives on `users.active` instead.
      allow delete: if false;
    }

    // Deny-by-default for everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
